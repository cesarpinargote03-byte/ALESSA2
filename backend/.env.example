# Copy this file to .env and replace every placeholder.
APP_ENV=development

# Mode: "local" connects directly to the Outlook Desktop app on Windows via MAPI (no Entra ID needed).
#       "graph" uses Microsoft Graph OAuth (requires MICROSOFT_CLIENT_ID and MICROSOFT_CLIENT_SECRET).
OUTLOOK_MODE=local

# Your corporate or personal email configured in Outlook:
MICROSOFT_ADMIN_EMAIL=tu.correo@empresa.com

# Only required when OUTLOOK_MODE=graph:
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
MICROSOFT_GRAPH_SCOPES=User.Read Mail.Read Calendars.ReadWrite

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_CACHE_ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

TOKEN_CACHE_PATH=data/msal_cache.bin
SESSION_MAX_AGE_SECONDS=28800
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:8100
FRONTEND_REDIRECT_URL=http://localhost:8100/
